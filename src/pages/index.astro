---
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import heroImage from "../assets/images/title.jpg";
import { courseMeta } from "../course-config";
import { sessionLabels, siteConfig } from "../site-config";
---

<ContentLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  heroImage={heroImage}
  heroImageAlt="Three figures in yellow hazmat suits walking away down a sickly-lit, featureless corridor lined with identical carpeted walls"
  {...siteConfig}
>
  <ul class="course-tags" aria-label="Course tags">
    {courseMeta.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  <h2>What you will do</h2>
  <p>
    You will log, corroborate and classify anomalous phenomena using the
    department's observational method; run two supervised on-campus
    observations under the fieldwork safety protocol; survey a regional and a
    global corpus of documented cases as comparative desk study; and evaluate
    the competing theoretical frameworks currently offered for what the
    cases converge on. You walk out with a case file, a comparative
    literature review, and a containment/warding protocol for a novel case —
    the applied method, exercised end to end.
  </p>

  <h2>Who it is for</h2>
  <p>
    Students who can already log an observation without interpreting it as
    they go, and who are prepared to treat a protective ritual, a
    contested causal theory, or a widely-circulated report as evidence to be
    weighed rather than folklore to be dismissed. No prior anomalology is
    assumed; a working comparative-method habit from any empirical discipline
    transfers directly.
  </p>

  <h2>Where to go next</h2>
  <CardGrid columns={2}>
    <Card title="Timetable" href="/timetable/">
      <p>The whole semester at a glance: phase, practical and lecture for every week.</p>
    </Card>
    <Card title={sessionLabels.plural} href="/sessions/">
      <p>The weekly schedule and what happens in each teaching session.</p>
    </Card>
    <Card title="Assessment" href="/assessments/">
      <p>What is marked, what it is worth, and when it is due.</p>
    </Card>
    <Card title="People" href="/people/">
      <p>Who teaches the course and how to reach them.</p>
    </Card>
  </CardGrid>
</ContentLayout>

<style>
  .course-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 0 2rem;
    padding: 0;
    list-style: none;
  }

  .course-tags li {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    color: var(--at-text-secondary);
    background: var(--at-bg-alt);
    font-size: 0.9rem;
  }
</style>
